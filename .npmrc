registry=https://registry.npmjs.org/
# A version must have been published for 7 days before npm installs it
min-release-age=7
save-exact=true
# No audit nor funding message on install: run `npm audit` explicitly when auditing
audit=false
fund=false
# A dependency install script must be approved in the allowScripts of package.json: an unreviewed
# one fails the install. Review it, then `npm install-scripts approve|deny <pkg>`
strict-allow-scripts=true

{
  "name": "@jondeodat/claude-setup-cli",
  "version": "0.2.0",
  "description": "Registers the Claude Code marketplaces and installs the plugins that a project declares in .claude/settings.json, at project scope.",
  "license": "MIT",
  "type": "module",
  "author": "Jon Deodat <deodatamadeus@gmail.com>",
  "homepage": "https://github.com/jondeodat/claude-setup-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jondeodat/claude-setup-cli.git"
  },
  "bugs": {
    "url": "https://github.com/jondeodat/claude-setup-cli/issues"
  },
  "bin": {
    "claude-setup": "./dist/claude-setup-cli.js"
  },
  "files": [
    "dist/claude-setup.js",
    "dist/claude-setup-cli.js"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "node claude-setup-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm test && npm run format:check && npm run build",
    "push": "npm publish"
  },
  "keywords": [
    "claude",
    "claude-code",
    "plugin",
    "marketplace",
    "setup"
  ],
  "devDependencies": {
    "@types/node": "24.19.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {}
}
